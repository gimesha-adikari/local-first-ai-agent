{
  "identifier": "main",
  "description": "Access saved conversations, the local inference worker, and explicitly authorized local agent tools.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-bootstrap",
    "allow-list-conversations",
    "allow-get-conversation",
    "allow-create-conversation",
    "allow-rename-conversation",
    "allow-set-system-prompt",
    "allow-delete-conversation",
    "allow-send-message",
    "allow-regenerate",
    "allow-stop-generation",
    "allow-choose-model",
    "allow-load-model",
    "allow-save-model-settings",
    "allow-unload-model",
    "allow-save-preferences",
    "allow-inference-status",
    "allow-start-agent-task",
    "allow-cancel-agent-task",
    "allow-respond-agent-approval",
    "allow-list-agent-tasks",
    "allow-get-agent-task",
    "allow-choose-agent-file",
    "allow-choose-agent-directory",
    "allow-list-agent-scopes",
    "allow-revoke-agent-scope",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
