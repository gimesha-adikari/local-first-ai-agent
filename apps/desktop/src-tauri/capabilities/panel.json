    "panel"
  ],
  "permissions": [
    "allow-glance-state",
    "allow-glance-clipboard",
    "allow-glance-run",
    "allow-glance-stop",
    "allow-glance-copy",
    "allow-glance-remember",
    "allow-glance-dismiss",
    "allow-glance-open-main",
    "allow-glance-capture",
    "allow-glance-capture-clear",
    "allow-glance-ocr",
    "allow-glance-estimate"
  ]
}
